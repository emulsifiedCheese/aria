{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria.local/schemas/phase_10_3_split_assignment.schema.json",
  "title": "ARIA Phase 10.3 Grouped Split Assignment",
  "description": "One feature-row assignment to the locked external test component or one leave-one-session-out development fold.",
  "type": "object",
  "required": [
    "schema_version",
    "split_policy_id",
    "dataset_version",
    "assignment_id",
    "partition",
    "validation_fold_id",
    "session_id",
    "participant_id",
    "episode_id",
    "window_id",
    "source_annotation_id"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "split_policy_id": {
      "type": "string",
      "const": "zone-a-phase10.3-external-test-loso-v1"
    },
    "dataset_version": {
      "type": "string",
      "const": "zone-a-phase10-features-v1"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^split_[a-f0-9]{16}$"
    },
    "partition": {
      "type": "string",
      "enum": ["development", "external_test"]
    },
    "validation_fold_id": {
      "type": ["string", "null"],
      "pattern": "^fold_[0-9]{2}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^zone_a_[0-9]{8}T[0-9]{6}SGT_[a-z0-9]{4,16}$"
    },
    "participant_id": {"type": "string", "pattern": "^P[0-9]{4}$"},
    "episode_id": {"type": "string", "pattern": "^episode_[a-f0-9]{16}$"},
    "window_id": {
      "type": "string",
      "pattern": "^zone_a_[0-9]+_[0-9]+$"
    },
    "source_annotation_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"partition": {"const": "development"}}},
      "then": {
        "properties": {"validation_fold_id": {"type": "string"}}
      }
    },
    {
      "if": {"properties": {"partition": {"const": "external_test"}}},
      "then": {
        "properties": {"validation_fold_id": {"type": "null"}}
      }
    }
  ],
  "additionalProperties": false
}
