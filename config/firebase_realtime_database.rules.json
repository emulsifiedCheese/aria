{
  "rules": {
    ".read": false,
    ".write": false,
    "aria": {
      "schema_version_1": {
        "predictions": {
          ".read": "auth != null && auth.uid === 'aria-phase12-3-sync'",
          "$prediction_id": {
            ".write": "auth != null && auth.uid === 'aria-phase12-3-sync' && newData.exists() && !data.exists()",
            ".validate": "$prediction_id.matches(/^prediction_[a-z0-9_-]{4,64}$/) && newData.hasChildren(['schema_version', 'prediction_id', 'emitted_at_sgt', 'uploaded_at_sgt', 'zone', 'model_version', 'preprocessing_version', 'prediction_available', 'availability']) && newData.child('prediction_id').val() === $prediction_id && ((newData.child('prediction_available').val() === true && newData.hasChildren(['predicted_activity', 'confidence']) && !newData.child('unavailable_reason').exists()) || (newData.child('prediction_available').val() === false && newData.hasChildren(['unavailable_reason']) && !newData.child('predicted_activity').exists() && !newData.child('confidence').exists()))",
            "schema_version": {
              ".validate": "newData.isNumber() && newData.val() === 1"
            },
            "prediction_id": {
              ".validate": "newData.isString()"
            },
            "emitted_at_sgt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*\\+08:00$/)"
            },
            "uploaded_at_sgt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*\\+08:00$/)"
            },
            "zone": {
              ".validate": "newData.isString() && newData.val() === 'A'"
            },
            "model_version": {
              ".validate": "newData.isString() && newData.val() === 'zone-a-camera-only-rf-v1'"
            },
            "preprocessing_version": {
              ".validate": "newData.isString() && newData.val() === 'zone-a-phase12.1-single-track-window-v1'"
            },
            "prediction_available": {
              ".validate": "newData.isBoolean()"
            },
            "predicted_activity": {
              ".validate": "newData.isString() && (newData.val() === 'Serving/Processing' || newData.val() === 'Idle/Waiting' || newData.val() === 'Reaching/Handling')"
            },
            "confidence": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "unavailable_reason": {
              ".validate": "newData.isString() && (newData.val() === 'excluded_interval' || newData.val() === 'insufficient_modalities' || newData.val() === 'missing_camera_track' || newData.val() === 'low_confidence' || newData.val() === 'model_error')"
            },
            "availability": {
              ".validate": "newData.hasChildren(['camera_available', 'pose_available', 'esp_a1_available', 'esp_a2_available'])",
              "camera_available": {
                ".validate": "newData.isBoolean()"
              },
              "pose_available": {
                ".validate": "newData.isBoolean()"
              },
              "esp_a1_available": {
                ".validate": "newData.isBoolean()"
              },
              "esp_a2_available": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "acceptance": {
          ".read": "auth != null && auth.uid === 'aria-phase12-3-sync'",
          "$acceptance_id": {
            ".write": "auth != null && auth.uid === 'aria-phase12-3-sync'",
            ".validate": "newData.hasChildren(['schema_version', 'input_scope', 'participant_data_used', 'created_at_sgt'])",
            "schema_version": {
              ".validate": "newData.isNumber() && newData.val() === 1"
            },
            "input_scope": {
              ".validate": "newData.isString() && newData.val() === 'synthetic'"
            },
            "participant_data_used": {
              ".validate": "newData.isBoolean() && newData.val() === false"
            },
            "created_at_sgt": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*\\+08:00$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}